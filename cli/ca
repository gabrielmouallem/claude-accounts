def state():
    cfg = load()
    accs = {n: {"config_dir": a["config_dir"], "login": login_state(a), "docker_login": docker_login_state(a),
                "desktop_cmd": desktop_cmd(a)} for n, a in cfg["accounts"].items()}
    return {"accounts": accs, "repos": rows(cfg)}

def make_handler(token, port, launch=True):
    allowed_hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass   # no request logging (URL contains the token)
        def _send(self, code, body, ctype="application/json"):
            data = body.encode() if isinstance(body, str) else json.dumps(body).encode()
            self.send_response(code); self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store"); self.send_header("X-Frame-Options", "DENY")
            self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'; connect-src 'self'")
            self.end_headers(); self.wfile.write(data)
        def _authed(self, qtoken=None):
            if self.headers.get("Host") not in allowed_hosts:   # DNS-rebinding guard
                return False
            t = qtoken if qtoken is not None else self.headers.get("X-CA-Token", "")
            return hmac.compare_digest(t or "", token)
        def do_GET(self):
            u = urlparse(self.path)
            if u.path == "/":
                if not self._authed(parse_qs(u.query).get("token", [""])[0]):
                    return self._send(403, "forbidden", "text/plain")
                return self._send(200, PAGE, "text/html; charset=utf-8")
            if u.path == "/api/state":
                if not self._authed(): return self._send(403, {"error": "forbidden"})
                return self._send(200, state())
            self._send(404, {"error": "not found"})
        def do_POST(self):
            if not self._authed(): return self._send(403, {"error": "forbidden"})
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0)) or 0) or b"{}")
                return self._send(200, self.post(urlparse(self.path).path, body))
            except SystemExit as e:
                return self._send(400, {"error": str(e)})
            except Exception as e:
                return self._send(400, {"error": f"{type(e).__name__}: {e}"})
        def post(self, path, b):
            cfg = load()
            if path == "/api/bind":
                p = bind(cfg, b["repo"], b["account"], b.get("mode", "terminal")); save(cfg); return {"ok": True, "repo": p}
            if path == "/api/add-account":
                add_account(cfg, b["name"]); save(cfg); return {"ok": True}
            if path != "/api/action":
                raise SystemExit("unknown endpoint")
            a = b.get("action")
            if a == "terminal":
                repo, bd = find_repo(cfg, b["repo"])
                if not bd: raise SystemExit("repo not bound")
                cmd = command_for(repo, bd, cfg)
                if bd.get("mode") == "desktop":
                    cmd = terminal_cmd(repo, cfg["accounts"][bd["account"]])
                ok, m = open_terminal(cmd) if launch else (False, "launch disabled")
                return {"ok": ok, "message": m, "command": cmd}
            acc = cfg["accounts"].get(b.get("account"))
            if not acc: raise SystemExit("unknown account")
            if a == "login":
                cmd = login_cmd(acc); ok, m = open_terminal(cmd) if launch else (False, "launch disabled")
                return {"ok": ok, "message": m + " - complete the browser sign-in there", "command": cmd}
            if a == "desktop":
                cmd = desktop_cmd(acc)
                if launch and SYSTEM in ("Darwin", "Windows"):
                    subprocess.Popen(cmd, shell=True); return {"ok": True, "message": "Desktop instance launched", "command": cmd}
                return {"ok": False, "message": "Desktop launch only on macOS/Windows; command:", "command": cmd}
            raise SystemExit("unknown action")
    return H

def serve(port=0, launch=True, open_browser=True):
    token = secrets.token_urlsafe(24)
    srv = ThreadingHTTPServer(("127.0.0.1", port), None)
    port = srv.server_address[1]
    srv.RequestHandlerClass = make_handler(token, port, launch)
    url = f"http://127.0.0.1:{port}/?token={token}"
    print(f"ca UI: {url}\n(Ctrl+C to stop)", flush=True)
    if open_browser and os.environ.get("CA_NO_BROWSER") != "1":
        import webbrowser; webbrowser.open(url)
    try: srv.serve_forever()
    except KeyboardInterrupt: pass

# ---------------------------------------------------------------- CLI
def main(argv=None):
    ap = argparse.ArgumentParser(prog="ca", description=__doc__.splitlines()[0])
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("add-account"); p.add_argument("name"); p.add_argument("--config-dir"); p.add_argument("--desktop-dir"); p.add_argument("--docker-dir")
    p = sp.add_parser("bind"); p.add_argument("repo"); p.add_argument("account"); p.add_argument("--mode", default="terminal", choices=MODES)
    p = sp.add_parser("unbind"); p.add_argument("repo")
    sp.add_parser("list")
    p = sp.add_parser("status"); p.add_argument("--deep", action="store_true", help="also ask `claude auth status` (local, prints no secrets)")
    p = sp.add_parser("run"); p.add_argument("repo", nargs="?"); p.add_argument("--worktree", "-w", nargs="?", const="")
    p.add_argument("--print", action="store_true", help="print command instead of running")
    p = sp.add_parser("login"); p.add_argument("account"); p.add_argument("--print", action="store_true")
    p = sp.add_parser("desktop"); p.add_argument("account"); p.add_argument("--launch", action="store_true")
    p.add_argument("--os", choices=["Darwin", "Windows", "Linux"], default=SYSTEM)
    p = sp.add_parser("shell-hook"); p.add_argument("kind", choices=["direnv", "zsh", "bash"]); p.add_argument("repo", nargs="?")
    p.add_argument("--write", action="store_true", help="direnv: append to <repo>/.envrc")
    p = sp.add_parser("env"); p.add_argument("path", nargs="?"); p.add_argument("--shell", action="store_true")
    p = sp.add_parser("docker-run"); p.add_argument("repo", nargs="?"); p.add_argument("--engine", choices=["docker", "container"], default="docker")
    p.add_argument("--build", action="store_true"); p.add_argument("--print", action="store_true"); p.add_argument("--worktree", "-w", nargs="?", const=None)
    p = sp.add_parser("ui"); p.add_argument("--port", type=int, default=0); p.add_argument("--no-launch", action="store_true", help="never spawn terminals/apps")
    argv = list(sys.argv[1:] if argv is None else argv)
    extra = argv[argv.index("--") + 1:] if "--" in argv else []   # args after -- go to claude
    argv = argv[:argv.index("--")] if "--" in argv else argv
    a = ap.parse_args(argv)
    cfg = load()

    if a.cmd == "add-account":
        acc = add_account(cfg, a.name, a.config_dir, a.desktop_dir, a.docker_dir); save(cfg)
        print(json.dumps({a.name: acc}, indent=2)); print(f"next: ca login {a.name}")
    elif a.cmd == "bind":
        p = bind(cfg, a.repo, a.account, a.mode); save(cfg); print(f"{p} -> {a.account} ({a.mode})")
    elif a.cmd == "unbind":
        cfg["repos"].pop(norm(a.repo), None); save(cfg)
    elif a.cmd in ("list", "status"):
        print("ACCOUNTS"); 
        for n, acc in sorted(cfg["accounts"].items()):
            extra = f"  [{deep_status(acc)}]" if a.cmd == "status" and getattr(a, "deep", False) else ""
            print(f"  {n:<14} cli={login_state(acc):<14} container={docker_login_state(acc):<14} {acc['config_dir']}{extra}")
        print("REPOS")
        for r in rows(cfg):
            flag = "" if r["exists"] else "  (missing)"
            print(f"  {r['repo']:<50} -> {r['account']:<14} {r['mode']:<9} {r['login'] if a.cmd=='status' else ''}{flag}")
        if a.cmd == "status":
            r, b = find_repo(cfg)
            print(f"CWD: {'bound to ' + b['account'] + ' via ' + r if b else 'not bound'}")
    elif a.cmd == "run":
        repo, b = find_repo(cfg, a.repo)
        if not b: raise SystemExit("repo not bound; run: ca bind <repo> <account>")
        acc = cfg["accounts"][b["account"]]
        if b.get("mode") == "docker":
            return main(["docker-run", repo] + (["--print"] if a.print else []) + (["-w", a.worktree] if a.worktree else []))
        argv = claude_argv(a.worktree, extra)
        if a.print:
            print(terminal_cmd(repo, acc, a.worktree, extra)); return 0
        print(f"[ca] {os.path.basename(repo)} -> account '{b['account']}'", file=sys.stderr)
        os.chdir(repo)
        exe = shutil.which("claude") or "claude"
        if SYSTEM == "Windows":
            return subprocess.call([exe] + argv[1:], env=claude_env(acc))
        os.execvpe(exe, argv, claude_env(acc))
    elif a.cmd == "login":
        acc = cfg["accounts"].get(a.account) or sys.exit(f"unknown account {a.account}")
        if a.print: print(login_cmd(acc)); return 0
        print(f"[ca] signing in account '{a.account}' (config dir {acc['config_dir']})", file=sys.stderr)
        return subprocess.call(["claude", "auth", "login"], env=claude_env(acc))
    elif a.cmd == "desktop":
        acc = cfg["accounts"].get(a.account) or sys.exit(f"unknown account {a.account}")
        cmd = desktop_cmd(acc, a.os); print(cmd)
        if a.launch and a.os == SYSTEM and SYSTEM in ("Darwin", "Windows"):
            subprocess.Popen(cmd, shell=True)
    elif a.cmd == "shell-hook":
        out = shell_hook(a.kind, a.repo, cfg)
        if a.kind == "direnv" and a.write:
            r, _ = find_repo(cfg, a.repo)
            with open(os.path.join(r, ".envrc"), "a") as f: f.write(out + "\n")
            print(f"appended to {r}/.envrc; run: direnv allow {r}")
        else:
            print(out)
    elif a.cmd == "env":
        if a.shell: print(env_shell(cfg, a.path))
        else:
            r, b = find_repo(cfg, a.path)
            print(f"CLAUDE_CONFIG_DIR={cfg['accounts'][b['account']]['config_dir']}" if b else "not bound")
    elif a.cmd == "docker-run":
        repo, b = find_repo(cfg, a.repo)
        if not b: raise SystemExit("repo not bound")
        acc = cfg["accounts"][b["account"]]
        ctx = write_dockerfile()
        _, build, run = docker_cmds(repo, acc, a.engine, a.worktree)
        _, cbuild, crun = docker_cmds(repo, acc, "container" if a.engine == "docker" else "docker", a.worktree)
        print(f"# Dockerfile: {ctx}/Dockerfile\n# build: {build}\n# run:   {run}\n# alt ({'Apple container' if a.engine=='docker' else 'docker'}):\n#   {cbuild}\n#   {crun}")
        print("# first run: type /login inside the container (login stored in", acc["docker_config_dir"] + ")")
        if a.print: return 0
        if not shutil.which(a.engine): raise SystemExit(f"{a.engine} not found; commands printed above")
        if a.build or subprocess.run([a.engine, "image", "inspect", IMAGE], capture_output=True).returncode != 0:
            subprocess.check_call(shlex.split(build))
        return subprocess.call(shlex.split(run))
    elif a.cmd == "ui":
        serve(a.port, launch=not a.no_launch)
    return 0

if __name__ == "__main__":
    sys.exit(main() or 0)
