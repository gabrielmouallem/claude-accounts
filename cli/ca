#!/usr/bin/env python3
"""ca - bind each git repo to its own Claude Code account (stdlib only).

Accounts are isolated by CLAUDE_CONFIG_DIR (CLI) and by Electron
--user-data-dir (Claude Desktop). Credential files are only checked for
existence; their contents are never read, logged or transmitted.
"""
# The shell hook runs `ca env --shell` before every prompt, so only what that needs loads up front. argparse,
# hashlib and subprocess load where they are used; up front they doubled its start-up time.
import json, os, re, shlex, sys

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get("CA_CONFIG") or os.path.join(HOME, ".config", "claude-accounts", "config.json")
BASE_DIR = os.path.dirname(CONFIG_PATH)
MODES = ("terminal", "docker", "desktop")
IMAGE = "claude-code-ca:latest"
SYSTEM = {"darwin": "Darwin", "win32": "Windows"}.get(sys.platform, "Linux")  # same rule as src/core.js
# Same rule as the app (src/core.js): a letter or number first, then letters, numbers, dot, dash or underscore; 64 at most.
ACCOUNT_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
# Account names become folder names, and Windows can't use these: it drops a trailing dot (so "work." would share
# "work"), and device names such as con or nul, with or without an extension, aren't folders at all.
WINDOWS_DEVICE = re.compile(r"(con|prn|aux|nul|com[0-9]|lpt[0-9])(\.|$)", re.I)
# Same rule as worktree() in src/validate.js.
WORKTREE_RE = re.compile(r"[A-Za-z0-9._/-]{1,100}")
# cmd.exe treats these as syntax outside quotes (see win_quote)
CMD_SPECIAL = re.compile(r'[\s&|<>^(),;=!"%]')
# and these anywhere in the arguments of a .cmd or .bat it runs, quoted or not (see check_cmd_args)
CMD_META = re.compile(r'["&|<>^%!()\r\n]')
# Windows PATH entries that name a drive or a server; cmd reads any other (".", "\tools") against the current folder
WIN_ABS_DIR = re.compile(r'"?([A-Za-z]:[\\/]|\\\\[^\\/])')
# The Windows lines ca prints are for cmd: they start with @, which PowerShell can't parse, and stop cmd from running a
# program from the current folder by name. Same as src/core.js.
WIN_NO_CWD = 'set "NoDefaultCurrentDirectoryInExePath=1"'

DOCKERFILE = """FROM node:24-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates openssh-client \\
 && rm -rf /var/lib/apt/lists/* && npm i -g @anthropic-ai/claude-code && npm cache clean --force
USER node
ENV CLAUDE_CONFIG_DIR=/home/node/.claude
WORKDIR /workspace
CMD ["claude"]
"""

# ---------------------------------------------------------------- config
def load():
    if not os.path.exists(CONFIG_PATH):
        return {"accounts": {}, "repos": {}}
    with open(CONFIG_PATH, encoding="utf-8") as f:
        cfg = json.load(f)
    for k in ("accounts", "repos"):
        if not isinstance(cfg.get(k), dict):
            cfg[k] = {}
    return cfg

def save(cfg):
    os.makedirs(BASE_DIR, mode=0o700, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    # 0600 like the app; chmod as well, because O_CREAT keeps the mode of a leftover tmp file
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, sort_keys=True, ensure_ascii=False)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_PATH)

def norm(p):
    return os.path.realpath(os.path.expanduser(p))

def valid_account_name(name):
    return (isinstance(name, str) and ACCOUNT_RE.fullmatch(name) is not None and not name.endswith(".")
            and WINDOWS_DEVICE.match(name) is None)

def valid_worktree(name):
    return name in (None, "") or (WORKTREE_RE.fullmatch(name) is not None and not name.startswith("-"))

def add_account(cfg, name, config_dir=None, desktop_dir=None, docker_dir=None):
    if not valid_account_name(name):
        raise SystemExit(f"invalid account name: {name!r} (letters, numbers, dot, dash and underscore, up to 64, "
                         "starting with a letter or number, not ending with a dot, and no Windows device name "
                         "such as con or nul)")
    same = next((n for n in cfg["accounts"] if n != name and n.lower() == name.lower()), None)
    if same:  # folders ignore case on macOS and Windows, so both names would share one login
        raise SystemExit(f"account {same!r} already exists")
    root = os.path.join(BASE_DIR, "accounts", name)
    acc = {
        "config_dir": norm(config_dir or os.path.join(root, "claude")),
        "desktop_user_data_dir": norm(desktop_dir or os.path.join(root, "desktop")),
        # separate dir for container logins: on macOS the host login lives in the
        # Keychain, which a Linux container cannot see, so containers log in themselves.
        "docker_config_dir": norm(docker_dir or os.path.join(root, "docker-claude")),
    }
    for d in acc.values():
        os.makedirs(d, mode=0o700, exist_ok=True)
    cfg["accounts"][name] = acc
    return acc

def bind(cfg, repo, account, mode="terminal"):
    if account not in cfg["accounts"]:
        raise SystemExit(f"unknown account {account!r}; run: ca add-account {account}")
    if mode not in MODES:
        raise SystemExit(f"mode must be one of {MODES}")
    path = norm(repo)
    if not os.path.isdir(path):
        raise SystemExit(f"not a directory: {path}")
    cfg["repos"][path] = {"account": account, "mode": mode}
    return path

def account_of(cfg, binding):
    """The account a binding points to, or a clear error when it is gone from the config."""
    name = binding["account"]
    if name not in cfg["accounts"]:
        raise SystemExit(f"account {name!r} is not configured; run: ca add-account {name} (or bind the repo to another account)")
    return cfg["accounts"][name]

def find_repo(cfg, path=None):
    """Return (repo_path, binding) for path or its nearest bound parent."""
    p = norm(path or os.getcwd())
    while True:
        if p in cfg["repos"]:
            return p, cfg["repos"][p]
        parent = os.path.dirname(p)
        if parent == p:
            return None, None
        p = parent

# ---------------------------------------------------------------- status
def login_state(acc):
    """Existence checks only - never opens credential files."""
    d = acc["config_dir"]
    if os.path.exists(os.path.join(d, ".credentials.json")):
        return "logged-in"
    if SYSTEM == "Darwin" and os.path.exists(os.path.join(d, ".claude.json")):
        return "keychain?"   # macOS keeps the token in the Keychain; run `ca status --deep`
    return "not-logged-in"

def docker_login_state(acc):
    return "logged-in" if os.path.exists(os.path.join(acc["docker_config_dir"], ".credentials.json")) else "not-logged-in"

def deep_status(acc):
    """Ask the official CLI (local check, prints email/plan, never the token)."""
    import subprocess
    exe = program("claude")
    if not exe:
        return "error: claude CLI not found"
    try:
        r = subprocess.run([exe, "auth", "status", "--text"], env=child_env(claude_env(acc)), cwd=HOME,
                           capture_output=True, text=True, timeout=30)
        return (r.stdout or r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr) else f"exit {r.returncode}"
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"error: {e}"

# ---------------------------------------------------------------- commands
def claude_env(acc, base=None):
    # Every spelling goes, since Windows ignores case in names. A global key would override the subscription login.
    env = {k: v for k, v in (os.environ if base is None else base).items()
           if k.upper() not in ("ANTHROPIC_API_KEY", "CLAUDE_CONFIG_DIR")}
    env["CLAUDE_CONFIG_DIR"] = acc["config_dir"]
    return env

def program(name):
    """`name` from PATH by full path, or None. Never from the current folder, which Windows searches first (and
    shutil.which there): a repository could hold its own claude.bat. A PATH entry that isn't absolute means the
    current folder too."""
    path = os.environ.get("PATH", "")
    if SYSTEM == "Windows":
        dirs = [d.strip('"') for d in absolute_dirs(path).split(";") if d]
        exts = [e for e in os.environ.get("PATHEXT", ".COM;.EXE;.BAT;.CMD").split(";")
                if e.lower() in (".com", ".exe", ".bat", ".cmd")]
    else:
        dirs, exts = [d for d in path.split(":") if d.startswith("/")], [""]
    for d in dirs:
        for ext in exts:
            p = os.path.join(d, name + ext)
            if os.path.isfile(p) and os.access(p, os.X_OK):
                return p
    return None

def absolute_dirs(value):
    """The Windows PATH entries that name a drive or a server. Same rule as src/core.js."""
    return ";".join(d for d in value.split(";") if WIN_ABS_DIR.match(d))

def windows_env(env):
    return {k: absolute_dirs(v) if k.upper() == "PATH" else v for k, v in env.items()}

def child_env(env):
    """The environment of a program ca starts. On Windows, a .cmd runs through cmd, and npm's claude.cmd runs node by
    name: NoDefaultCurrentDirectoryInExePath keeps cmd from finding a node.cmd in the current folder, which for
    `ca run` is the repository."""
    return dict(windows_env(env), NoDefaultCurrentDirectoryInExePath="1") if SYSTEM == "Windows" else env

def check_cmd_args(exe, args):
    """Windows runs a .cmd or .bat through cmd, which reads CMD_META as syntax in its arguments, quoted or not."""
    if SYSTEM == "Windows" and exe.lower().endswith((".cmd", ".bat")):
        for a in args:
            if CMD_META.search(a):
                raise SystemExit(f"{os.path.basename(exe)} runs through cmd, which would read part of {a!r} as a "
                                 "command; leave out \" & | < > ^ % ! ( ) or use a version that isn't a .cmd")

def claude_argv(worktree=None, extra=()):
    argv = ["claude"]
    if worktree is not None:
        argv += ["--worktree"] + ([worktree] if worktree else [])
    return argv + list(extra)

def win_quote(s):
    """One argument for a cmd.exe line that a person copies (ca never runs these through cmd).
    Quotes keep & | < > ^ literal; %VAR% still expands inside them, which cmd offers no way around. A double quote
    inside the argument can't be kept: it would end the quoting and expose what follows, so it is refused."""
    if '"' in s:
        raise SystemExit(f"can't put {s!r} in a cmd line: it holds a double quote")
    if s and not CMD_SPECIAL.search(s):
        return s
    return '"' + re.sub(r"\\+\Z", lambda m: m.group(0) * 2, s) + '"'   # the reader would take \" for an escaped quote

def q(s, system=SYSTEM):
    return win_quote(s) if system == "Windows" else shlex.quote(s)

def terminal_cmd(repo, acc, worktree=None, extra=(), system=SYSTEM):
    argv = " ".join(q(a, system) for a in claude_argv(worktree, extra))
    if system == "Windows":
        return f'@pushd {q(repo, system)} && {WIN_NO_CWD} && set "CLAUDE_CONFIG_DIR={acc["config_dir"]}" && set "ANTHROPIC_API_KEY=" && {argv}'
    return f"cd {q(repo, system)} && env -u ANTHROPIC_API_KEY CLAUDE_CONFIG_DIR={q(acc['config_dir'], system)} {argv}"

def login_cmd(acc, system=SYSTEM):
    if system == "Windows":
        return f'@{WIN_NO_CWD} && set "CLAUDE_CONFIG_DIR={acc["config_dir"]}" && set "ANTHROPIC_API_KEY=" && claude auth login'
    return f"env -u ANTHROPIC_API_KEY CLAUDE_CONFIG_DIR={q(acc['config_dir'], system)} claude auth login"

def desktop_cmd(acc, system=SYSTEM):
    ud, cd = acc["desktop_user_data_dir"], acc["config_dir"]
    if system == "Darwin":
        # -n = new instance; --env needs macOS 13+ (only matters if Desktop honours CLAUDE_CONFIG_DIR)
        return f'open -n -a "Claude" --env CLAUDE_CONFIG_DIR={shlex.quote(cd)} --args --user-data-dir={shlex.quote(ud)}'
    if system == "Windows":
        return (f'@set "CLAUDE_CONFIG_DIR={cd}" && start "" "%LOCALAPPDATA%\\AnthropicClaude\\claude.exe" '
                f'--user-data-dir="{ud}"')
    return f"# No official Claude Desktop for Linux; use terminal/docker mode.\n# Unofficial builds: CLAUDE_CONFIG_DIR={shlex.quote(cd)} claude-desktop --user-data-dir={shlex.quote(ud)}"

def desktop_launch(acc, system=SYSTEM):
    """argv for a separate Claude Desktop instance, run without a shell (None where there is no Desktop)."""
    if system == "Darwin":
        return ["open", "-n", "-a", "Claude", "--env", f"CLAUDE_CONFIG_DIR={acc['config_dir']}",
                "--args", f"--user-data-dir={acc['desktop_user_data_dir']}"]
    if system == "Windows":
        return [os.path.join(os.environ.get("LOCALAPPDATA", ""), "AnthropicClaude", "claude.exe"),
                f"--user-data-dir={acc['desktop_user_data_dir']}"]
    return None

def docker_argv(repo, acc, engine="docker", worktree=None, extra=()):
    """(build, run) argv for Docker or Apple's `container` CLI (macOS 26, Apple silicon)."""
    import hashlib
    name = "ca-" + hashlib.sha1(repo.encode()).hexdigest()[:8]
    build = [engine, "build", "-t", IMAGE, os.path.join(BASE_DIR, "docker")]
    run = [engine, "run", "--rm", "-it", "--name", name, "-v", f"{acc['docker_config_dir']}:/home/node/.claude",
           "-v", f"{repo}:/workspace", "-w", "/workspace", "-e", "CLAUDE_CONFIG_DIR=/home/node/.claude", IMAGE,
           *claude_argv(worktree, extra)]
    return build, run

def docker_cmds(repo, acc, engine="docker", worktree=None, extra=(), system=SYSTEM):
    build, run = docker_argv(repo, acc, engine, worktree, extra)
    line = lambda argv: " ".join(q(a, system) for a in argv)
    return os.path.join(BASE_DIR, "docker"), line(build), line(run)

def write_dockerfile():
    ctx = os.path.join(BASE_DIR, "docker"); os.makedirs(ctx, exist_ok=True)
    with open(os.path.join(ctx, "Dockerfile"), "w", encoding="utf-8") as f:
        f.write(DOCKERFILE)
    return ctx

def shell_hook(kind, repo=None, cfg=None):
    me = os.path.realpath(__file__)
    if kind == "direnv":
        cfg = cfg or load()
        r, b = find_repo(cfg, repo)
        if not b:
            raise SystemExit("repo not bound; run: ca bind <repo> <account>")
        return f"export CLAUDE_CONFIG_DIR={shlex.quote(account_of(cfg, b)['config_dir'])}"
    fn = f"""_ca_hook() {{ eval "$({shlex.quote(sys.executable)} {shlex.quote(me)} env --shell)"; }}"""
    if kind == "zsh":
        return fn + "\nautoload -U add-zsh-hook; add-zsh-hook chpwd _ca_hook; _ca_hook"
    if kind == "bash":
        return fn + '\nPROMPT_COMMAND="_ca_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"'
    raise SystemExit("kind must be direnv|zsh|bash")

# The shell hook keeps a CLAUDE_CONFIG_DIR you set yourself: it is saved when you enter a bound repo and put
# back when you leave, and a shell that never entered one is left alone. Same text as envShell in src/core.js.
ENV_ENTER = ('if [ -z "${CA_ACCOUNT+x}" ] && [ -n "${CLAUDE_CONFIG_DIR+x}" ]; then '
             'export CA_OUTER_CLAUDE_CONFIG_DIR="$CLAUDE_CONFIG_DIR"; fi; ')
ENV_LEAVE = ('if [ -n "${CA_ACCOUNT+x}" ]; then if [ -n "${CA_OUTER_CLAUDE_CONFIG_DIR+x}" ]; then '
             'export CLAUDE_CONFIG_DIR="$CA_OUTER_CLAUDE_CONFIG_DIR"; else unset CLAUDE_CONFIG_DIR; fi; '
             'unset CA_ACCOUNT CA_OUTER_CLAUDE_CONFIG_DIR; fi')

def env_shell(cfg, path=None):
    r, b = find_repo(cfg, path)
    if b and b["account"] in cfg["accounts"]:
        acc = cfg["accounts"][b["account"]]
        return f"{ENV_ENTER}export CLAUDE_CONFIG_DIR={shlex.quote(acc['config_dir'])}; export CA_ACCOUNT={shlex.quote(b['account'])}"
    return ENV_LEAVE

def rows(cfg):
    out = []
    for path, b in sorted(cfg["repos"].items()):
        acc = cfg["accounts"].get(b["account"])
        out.append({"repo": path, "account": b["account"], "mode": b.get("mode", "terminal"),
                    "exists": os.path.isdir(path),
                    "login": (docker_login_state(acc) if b.get("mode") == "docker" else login_state(acc)) if acc else "missing-account",
                    "command": command_for(path, b, cfg) if acc else ""})
    return out

def command_for(repo, b, cfg):
    acc = cfg["accounts"][b["account"]]
    mode = b.get("mode", "terminal")
    if mode == "docker":
        return docker_cmds(repo, acc)[2]
    if mode == "desktop":
        return desktop_cmd(acc)
    return terminal_cmd(repo, acc)

# ---------------------------------------------------------------- CLI
def main(argv=None):
    import argparse, subprocess
    ap = argparse.ArgumentParser(prog="ca", description=__doc__.splitlines()[0])
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("add-account"); p.add_argument("name"); p.add_argument("--config-dir"); p.add_argument("--desktop-dir"); p.add_argument("--docker-dir")
    p = sp.add_parser("bind"); p.add_argument("repo"); p.add_argument("account"); p.add_argument("--mode", default="terminal", choices=MODES)
    p = sp.add_parser("unbind"); p.add_argument("repo")
    sp.add_parser("list")
    p = sp.add_parser("status"); p.add_argument("--deep", action="store_true", help="also ask `claude auth status` (local, prints no secrets)")
    p = sp.add_parser("run"); p.add_argument("repo", nargs="?"); p.add_argument("--worktree", "-w", nargs="?", const="")
    p.add_argument("--print", action="store_true", help="print command instead of running")
    p = sp.add_parser("login"); p.add_argument("account"); p.add_argument("--print", action="store_true")
    p = sp.add_parser("desktop"); p.add_argument("account"); p.add_argument("--launch", action="store_true")
    p.add_argument("--os", choices=["Darwin", "Windows", "Linux"], default=SYSTEM)
    p = sp.add_parser("shell-hook"); p.add_argument("kind", choices=["direnv", "zsh", "bash"]); p.add_argument("repo", nargs="?")
    p.add_argument("--write", action="store_true", help="direnv: append to <repo>/.envrc")
    p = sp.add_parser("env"); p.add_argument("path", nargs="?"); p.add_argument("--shell", action="store_true")
    p = sp.add_parser("docker-run"); p.add_argument("repo", nargs="?"); p.add_argument("--engine", choices=["docker", "container"], default="docker")
    p.add_argument("--build", action="store_true"); p.add_argument("--print", action="store_true"); p.add_argument("--worktree", "-w", nargs="?", const="")
    argv = list(sys.argv[1:] if argv is None else argv)
    extra = argv[argv.index("--") + 1:] if "--" in argv else []   # args after -- go to claude
    argv = argv[:argv.index("--")] if "--" in argv else argv
    a = ap.parse_args(argv)
    if not valid_worktree(getattr(a, "worktree", None)):
        raise SystemExit(f"invalid worktree name: {a.worktree!r} (letters, numbers, dot, dash, underscore and slash, "
                         "up to 100, not starting with a dash)")
    cfg = load()

    if a.cmd == "add-account":
        acc = add_account(cfg, a.name, a.config_dir, a.desktop_dir, a.docker_dir); save(cfg)
        print(json.dumps({a.name: acc}, indent=2)); print(f"next: ca login {a.name}")
    elif a.cmd == "bind":
        p = bind(cfg, a.repo, a.account, a.mode); save(cfg); print(f"{p} -> {a.account} ({a.mode})")
    elif a.cmd == "unbind":
        cfg["repos"].pop(norm(a.repo), None); save(cfg)
    elif a.cmd in ("list", "status"):
        print("ACCOUNTS")
        for n, acc in sorted(cfg["accounts"].items()):
            extra = f"  [{deep_status(acc)}]" if a.cmd == "status" and getattr(a, "deep", False) else ""
            print(f"  {n:<14} cli={login_state(acc):<14} container={docker_login_state(acc):<14} {acc['config_dir']}{extra}")
        print("REPOS")
        for r in rows(cfg):
            flag = "" if r["exists"] else "  (missing)"
            print(f"  {r['repo']:<50} -> {r['account']:<14} {r['mode']:<9} {r['login'] if a.cmd=='status' else ''}{flag}")
        if a.cmd == "status":
            r, b = find_repo(cfg)
            print(f"CWD: {'bound to ' + b['account'] + ' via ' + r if b else 'not bound'}")
    elif a.cmd == "run":
        repo, b = find_repo(cfg, a.repo)
        if not b: raise SystemExit("repo not bound; run: ca bind <repo> <account>")
        acc = account_of(cfg, b)
        if b.get("mode") == "docker":
            return main(["docker-run", repo] + (["--print"] if a.print else []) + ([] if a.worktree is None else [f"--worktree={a.worktree}"])
                        + (["--", *extra] if extra else []))
        argv = claude_argv(a.worktree, extra)
        if a.print:
            print(terminal_cmd(repo, acc, a.worktree, extra)); return 0
        exe = program("claude") or sys.exit("claude not found on PATH")
        print(f"[ca] {os.path.basename(repo)} -> account '{b['account']}'", file=sys.stderr)
        if SYSTEM == "Windows":
            check_cmd_args(exe, argv[1:])
            if repo.startswith("\\\\") and exe.lower().endswith((".cmd", ".bat")):
                raise SystemExit(f"{os.path.basename(exe)} runs through cmd, which can't start in a network folder "
                                 f"({repo}); open the repository from the app, or map the share to a drive letter")
        os.chdir(repo)
        if SYSTEM == "Windows":
            return subprocess.call([exe] + argv[1:], env=child_env(claude_env(acc)))
        os.execve(exe, argv, claude_env(acc))
    elif a.cmd == "login":
        acc = cfg["accounts"].get(a.account) or sys.exit(f"unknown account {a.account}")
        if a.print: print(login_cmd(acc)); return 0
        print(f"[ca] signing in account '{a.account}' (config dir {acc['config_dir']})", file=sys.stderr)
        return subprocess.call([program("claude") or sys.exit("claude not found on PATH"), "auth", "login"],
                               env=child_env(claude_env(acc)), cwd=HOME)
    elif a.cmd == "desktop":
        acc = cfg["accounts"].get(a.account) or sys.exit(f"unknown account {a.account}")
        print(desktop_cmd(acc, a.os))
        argv = desktop_launch(acc) if a.launch and a.os == SYSTEM else None
        if argv:
            exe = argv[0] if os.path.isabs(argv[0]) else program(argv[0])
            if not exe or not os.path.exists(exe):
                raise SystemExit(f"Claude Desktop not found ({argv[0]})")
            subprocess.Popen([exe] + argv[1:], env=claude_env(acc))
    elif a.cmd == "shell-hook":
        out = shell_hook(a.kind, a.repo, cfg)
        if a.kind == "direnv" and a.write:
            r, _ = find_repo(cfg, a.repo)
            with open(os.path.join(r, ".envrc"), "a") as f: f.write(out + "\n")
            print(f"appended to {r}/.envrc; run: direnv allow {r}")
        else:
            print(out)
    elif a.cmd == "env":
        if a.shell: print(env_shell(cfg, a.path))
        else:
            r, b = find_repo(cfg, a.path)
            print(f"CLAUDE_CONFIG_DIR={account_of(cfg, b)['config_dir']}" if b else "not bound")
    elif a.cmd == "docker-run":
        repo, b = find_repo(cfg, a.repo)
        if not b: raise SystemExit("repo not bound; run: ca bind <repo> <account>")
        acc = account_of(cfg, b)
        ctx = write_dockerfile()
        _, build, run = docker_cmds(repo, acc, a.engine, a.worktree, extra)
        _, cbuild, crun = docker_cmds(repo, acc, "container" if a.engine == "docker" else "docker", a.worktree, extra)
        print(f"# Dockerfile: {ctx}/Dockerfile\n# build: {build}\n# run:   {run}\n# alt ({'Apple container' if a.engine=='docker' else 'docker'}):\n#   {cbuild}\n#   {crun}")
        print("# first run: type /login inside the container (login stored in", acc["docker_config_dir"] + ")")
        if a.print: return 0
        exe = program(a.engine) or sys.exit(f"{a.engine} not found; commands printed above")
        build_argv, run_argv = docker_argv(repo, acc, a.engine, a.worktree, extra)
        check_cmd_args(exe, build_argv[1:] + run_argv[1:])
        env = child_env(dict(os.environ))
        if a.build or subprocess.run([exe, "image", "inspect", IMAGE], capture_output=True, env=env).returncode != 0:
            subprocess.check_call([exe] + build_argv[1:], env=env)
        return subprocess.call([exe] + run_argv[1:], env=env)
    return 0

if __name__ == "__main__":
    if sys.argv[1:] == ["env", "--shell"]:   # the shell hook's call: answered without argparse
        print(env_shell(load())); sys.exit(0)
    sys.exit(main() or 0)
