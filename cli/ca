#!/usr/bin/env python3
"""ca - bind each git repo to its own Claude Code account (stdlib only).

Accounts are isolated by CLAUDE_CONFIG_DIR (CLI) and by Electron
--user-data-dir (Claude Desktop). Credential files are only checked for
existence; their contents are never read, logged or transmitted.
"""
import argparse, hashlib, hmac, html, json, os, platform, secrets, shlex, shutil, subprocess, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get("CA_CONFIG") or os.path.join(HOME, ".config", "claude-accounts", "config.json")
BASE_DIR = os.path.dirname(CONFIG_PATH)
MODES = ("terminal", "docker", "desktop")
IMAGE = "claude-code-ca:latest"
SYSTEM = platform.system()  # Darwin / Linux / Windows

DOCKERFILE = """FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates openssh-client \\
 && rm -rf /var/lib/apt/lists/* && npm i -g @anthropic-ai/claude-code && npm cache clean --force
USER node
ENV CLAUDE_CONFIG_DIR=/home/node/.claude
WORKDIR /workspace
CMD ["claude"]
"""

# ---------------------------------------------------------------- config
def load():
    if not os.path.exists(CONFIG_PATH):
        return {"accounts": {}, "repos": {}}
    with open(CONFIG_PATH) as f:
        cfg = json.load(f)
    cfg.setdefault("accounts", {}); cfg.setdefault("repos", {})
    return cfg

def save(cfg):
    os.makedirs(BASE_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2, sort_keys=True)
    os.replace(tmp, CONFIG_PATH)

def norm(p):
    return os.path.realpath(os.path.expanduser(p))

def add_account(cfg, name, config_dir=None, desktop_dir=None, docker_dir=None):
    if not name or any(c in name for c in "/\\ "):
        raise SystemExit(f"invalid account name: {name!r}")
    root = os.path.join(BASE_DIR, "accounts", name)
    acc = {
        "config_dir": norm(config_dir or os.path.join(root, "claude")),
        "desktop_user_data_dir": norm(desktop_dir or os.path.join(root, "desktop")),
        # separate dir for container logins: on macOS the host login lives in the
        # Keychain, which a Linux container cannot see, so containers log in themselves.
        "docker_config_dir": norm(docker_dir or os.path.join(root, "docker-claude")),
    }
    for d in acc.values():
        os.makedirs(d, mode=0o700, exist_ok=True)
    cfg["accounts"][name] = acc
    return acc

def bind(cfg, repo, account, mode="terminal"):
    if account not in cfg["accounts"]:
        raise SystemExit(f"unknown account {account!r}; run: ca add-account {account}")
    if mode not in MODES:
        raise SystemExit(f"mode must be one of {MODES}")
    path = norm(repo)
    if not os.path.isdir(path):
        raise SystemExit(f"not a directory: {path}")
    cfg["repos"][path] = {"account": account, "mode": mode}
    return path

def find_repo(cfg, path=None):
    """Return (repo_path, binding) for path or its nearest bound parent."""
    p = norm(path or os.getcwd())
    while True:
        if p in cfg["repos"]:
            return p, cfg["repos"][p]
        parent = os.path.dirname(p)
        if parent == p:
            return None, None
        p = parent

# ---------------------------------------------------------------- status
def login_state(acc):
    """Existence checks only - never opens credential files."""
    d = acc["config_dir"]
    if os.path.exists(os.path.join(d, ".credentials.json")):
        return "logged-in"
    if SYSTEM == "Darwin" and os.path.exists(os.path.join(d, ".claude.json")):
        return "keychain?"   # macOS keeps the token in the Keychain; run `ca status --deep`
    return "not-logged-in"

def docker_login_state(acc):
    return "logged-in" if os.path.exists(os.path.join(acc["docker_config_dir"], ".credentials.json")) else "not-logged-in"

def deep_status(acc):
    """Ask the official CLI (local check, prints email/plan, never the token)."""
    try:
        r = subprocess.run(["claude", "auth", "status", "--text"], env=claude_env(acc),
                           capture_output=True, text=True, timeout=30)
        return (r.stdout or r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr) else f"exit {r.returncode}"
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"error: {e}"

# ---------------------------------------------------------------- commands
def claude_env(acc, base=None):
    env = dict(base if base is not None else os.environ)
    env["CLAUDE_CONFIG_DIR"] = acc["config_dir"]
    env.pop("ANTHROPIC_API_KEY", None)  # don't let a global key override the subscription login
    return env

def claude_argv(worktree=None, extra=()):
    argv = ["claude"]
    if worktree is not None:
        argv += ["--worktree"] + ([worktree] if worktree else [])
    return argv + list(extra)

def q(s):
    return subprocess.list2cmdline([s]) if SYSTEM == "Windows" else shlex.quote(s)

def terminal_cmd(repo, acc, worktree=None, extra=()):
    argv = " ".join(q(a) for a in claude_argv(worktree, extra))
    if SYSTEM == "Windows":
        return f'cd /d {q(repo)} && set "CLAUDE_CONFIG_DIR={acc["config_dir"]}" && set "ANTHROPIC_API_KEY=" && {argv}'
    return f"cd {q(repo)} && env -u ANTHROPIC_API_KEY CLAUDE_CONFIG_DIR={q(acc['config_dir'])} {argv}"

def login_cmd(acc):
    if SYSTEM == "Windows":
        return f'set "CLAUDE_CONFIG_DIR={acc["config_dir"]}" && claude auth login'
    return f"CLAUDE_CONFIG_DIR={q(acc['config_dir'])} claude auth login"

def desktop_cmd(acc, system=SYSTEM):
    ud, cd = acc["desktop_user_data_dir"], acc["config_dir"]
    if system == "Darwin":
        # -n = new instance; --env needs macOS 13+ (only matters if Desktop honours CLAUDE_CONFIG_DIR)
        return f'open -n -a "Claude" --env CLAUDE_CONFIG_DIR={shlex.quote(cd)} --args --user-data-dir={shlex.quote(ud)}'
    if system == "Windows":
        return (f'set "CLAUDE_CONFIG_DIR={cd}" && start "" "%LOCALAPPDATA%\\AnthropicClaude\\claude.exe" '
                f'--user-data-dir="{ud}"')
    return f"# No official Claude Desktop for Linux; use terminal/docker mode.\n# Unofficial builds: CLAUDE_CONFIG_DIR={shlex.quote(cd)} claude-desktop --user-data-dir={shlex.quote(ud)}"

def docker_cmds(repo, acc, engine="docker", worktree=None, extra=()):
    ctx = os.path.join(BASE_DIR, "docker")
    inner = " ".join(shlex.quote(a) for a in claude_argv(worktree, extra))
    name = "ca-" + hashlib.sha1(repo.encode()).hexdigest()[:8]
    vol = f"{acc['docker_config_dir']}:/home/node/.claude"
    build = f"{engine} build -t {IMAGE} {shlex.quote(ctx)}"
    if engine == "container":   # Apple `container` CLI (macOS 26, Apple silicon) - untested here
        run = (f"container run --rm -it --name {name} -v {shlex.quote(vol)} -v {shlex.quote(repo + ':/workspace')} "
               f"-w /workspace -e CLAUDE_CONFIG_DIR=/home/node/.claude {IMAGE} {inner}")
    else:
        run = (f"docker run --rm -it --name {name} -v {shlex.quote(vol)} -v {shlex.quote(repo + ':/workspace')} "
               f"-w /workspace -e CLAUDE_CONFIG_DIR=/home/node/.claude {IMAGE} {inner}")
    return ctx, build, run

def write_dockerfile():
    ctx = os.path.join(BASE_DIR, "docker"); os.makedirs(ctx, exist_ok=True)
    with open(os.path.join(ctx, "Dockerfile"), "w") as f:
        f.write(DOCKERFILE)
    return ctx

def open_terminal(command):
    """Open a new terminal window running `command`. Returns (ok, message)."""
    if SYSTEM == "Darwin":
        script = f'tell application "Terminal" to do script {json.dumps(command)}\ntell application "Terminal" to activate'
        subprocess.Popen(["osascript", "-e", script]); return True, "opened Terminal.app"
    if SYSTEM == "Windows":
        subprocess.Popen(f'start "claude" cmd /k "{command}"', shell=True); return True, "opened cmd"
    for term, pre in (("x-terminal-emulator", ["-e"]), ("gnome-terminal", ["--"]), ("konsole", ["-e"]),
                      ("kitty", []), ("alacritty", ["-e"]), ("xterm", ["-e"])):
        if shutil.which(term):
            subprocess.Popen([term, *pre, "bash", "-lc", command + "; exec bash"]); return True, f"opened {term}"
    return False, "no terminal emulator found; copy the command instead"

def shell_hook(kind, repo=None, cfg=None):
    me = os.path.realpath(__file__)
    if kind == "direnv":
        cfg = cfg or load()
        r, b = find_repo(cfg, repo)
        if not b:
            raise SystemExit("repo not bound; run: ca bind <repo> <account>")
        return f"export CLAUDE_CONFIG_DIR={q(cfg['accounts'][b['account']]['config_dir'])}"
    fn = f"""_ca_hook() {{ eval "$({shlex.quote(sys.executable)} {shlex.quote(me)} env --shell)"; }}"""
    if kind == "zsh":
        return fn + "\nautoload -U add-zsh-hook; add-zsh-hook chpwd _ca_hook; _ca_hook"
    if kind == "bash":
        return fn + '\nPROMPT_COMMAND="_ca_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"'
    raise SystemExit("kind must be direnv|zsh|bash")

def env_shell(cfg, path=None):
    r, b = find_repo(cfg, path)
    if b and b["account"] in cfg["accounts"]:
        return f"export CLAUDE_CONFIG_DIR={q(cfg['accounts'][b['account']]['config_dir'])}; export CA_ACCOUNT={q(b['account'])}"
    return "unset CLAUDE_CONFIG_DIR CA_ACCOUNT"

def rows(cfg):
    out = []
    for path, b in sorted(cfg["repos"].items()):
        acc = cfg["accounts"].get(b["account"])
        out.append({"repo": path, "account": b["account"], "mode": b.get("mode", "terminal"),
                    "exists": os.path.isdir(path),
                    "login": (docker_login_state(acc) if b.get("mode") == "docker" else login_state(acc)) if acc else "missing-account",
                    "command": command_for(path, b, cfg) if acc else ""})
    return out

def command_for(repo, b, cfg):
    acc = cfg["accounts"][b["account"]]
    mode = b.get("mode", "terminal")
    if mode == "docker":
        return docker_cmds(repo, acc)[2]
    if mode == "desktop":
        return desktop_cmd(acc)
    return terminal_cmd(repo, acc)

